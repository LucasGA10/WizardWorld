
CREATE TABLE hpCharacterEntity (
    id TEXT NOT NULL PRIMARY KEY,
    json TEXT NOT NULL
);

selectHpCharacterById:
SELECT *
FROM hpCharacterEntity
WHERE id = ?;

selectAllHpCharacters:
SELECT *
FROM hpCharacterEntity;

insertHpCharacter:
INSERT OR REPLACE INTO hpCharacterEntity(
    id,
    json
) VALUES (?, ?);
